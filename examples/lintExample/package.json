{
  "name": "lint-example",
  "private": true,
  "description": "How a Max project lints its patches and runs its mUnit tests from npm scripts and CI",
  "scripts": {
    "lint": "munit lint .",
    "lint:fix": "munit lint . --fix",
    "lint:ci": "munit lint . --format junit --output build/lint.xml",
    "test": "munit run . --tests tests"
  },
  "devDependencies": {
    "munit-cli": "^0.1.0"
  }
}
