                    "text": "route type freq freq2 amp seed duration file trigger"
                }
            },
            {
                "box": {
                    "id": "obj-6",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 4,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "dsp.gen",
                        "rect": [ 80.0, 80.0, 900.0, 700.0 ],
                        "boxes": [
                            {
                                "box": {
                                    "code": "// mUnit.stimulus~: a test signal computed from a sample counter, so it is\n// the same every run. Params come from the patch; playing 1 restarts it.\nParam type(0), freq(440), freq2(2000), amp(1), seed(1), playing(0), sweepms(1000);\nHistory n(0), was(0);\nsr = samplerate;\ntrig = (playing > 0) && (was < 1);\nwas = playing;\nidx = trig ? 0 : n;\nn = (playing > 0) ? idx + 1 : 0;\ny = 0;\nif (playing > 0) {\n\tt = idx / sr;\n\tif (type == 0) {\n\t\ty = amp * sin(twopi * freq * t);\n\t} else if (type == 1) {\n\t\ty = (idx < 1) ? amp : 0;\n\t} else if (type == 2) {\n\t\tspan = max(sweepms, 1) * 0.001;\n\t\tk = (freq2 - freq) / span;\n\t\ttt = min(t, span);\n\t\ty = amp * sin(twopi * (freq * tt + 0.5 * k * tt * tt));\n\t} else if (type == 3) {\n\t\t// v - floor(v), not fract(v): gen's fract keeps the sign, so a\n\t\t// negative v would give h below 0 and noise down to -3 * amp\n\t\tv = sin(idx * 12.9898 + seed * 78.233) * 43758.5453;\n\t\th = v - floor(v);\n\t\ty = amp * (h * 2 - 1);\n\t}\n}\nout1 = y;",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-1",
                                    "maxclass": "codebox",
                                    "numinlets": 1,
                                    "numoutlets": 1,
                                    "outlettype": [ "" ],
                                    "patching_rect": [ 30.0, 80.0, 820.0, 520.0 ]
                                }
                            },
                            {
                                "box": {
                                    "id": "obj-2",
                                    "maxclass": "newobj",
                                    "numinlets": 0,
                                    "numoutlets": 1,
                                    "outlettype": [ "" ],
                                    "patching_rect": [ 30.0, 30.0, 40.0, 22.0 ],
                                    "text": "in 1"
                                }
                            },
                            {
                                "box": {
                                    "id": "obj-3",
                                    "maxclass": "newobj",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 30.0, 630.0, 46.5, 22.0 ],
                                    "text": "out 1"
                                }
                            }
                        ],
                        "lines": [
