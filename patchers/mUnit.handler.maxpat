            {
                "box": {
                    "id": "obj-33",
                    "linecount": 8,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 806.0, 602.0, 192.0, 114.0 ],
                    "text": "idle: a sequential harness opens its next patch. \nquit: only sent when the CLI runs the suite. Quit first (Max defers it), then close every window, so Max has nothing to reopen at the next launch and no save dialog can block the quit"
